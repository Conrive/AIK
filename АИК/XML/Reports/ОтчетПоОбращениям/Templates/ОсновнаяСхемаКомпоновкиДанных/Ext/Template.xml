<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Результат</dataPath>
			<field>Результат</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Результат</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Ссылка</dataPath>
			<field>Ссылка</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВнешнийНомер</dataPath>
			<field>ВнешнийНомер</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаРегистрации</dataPath>
			<field>ДатаРегистрации</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаИсполнения</dataPath>
			<field>ДатаИсполнения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата исполнения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СрокФактДней</dataPath>
			<field>СрокФактДней</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Срок факт дней</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Описание</dataPath>
			<field>Описание</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СрокНормативныйДней</dataPath>
			<field>СрокНормативныйДней</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Срок нормативный дней</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Просрочено</dataPath>
			<field>Просрочено</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Просрочено</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	УчетныйДокумент.Ссылка КАК Ссылка,
	УчетныйДокумент.ВнешнийНомер КАК ВнешнийНомер,
	УчетныйДокумент.ДатаРегистрации КАК ДатаРегистрации,
	УчетныйДокумент.ДатаИсполненияОбращения КАК ДатаИсполнения,
	УчетныйДокумент.РезультатОбращения КАК Результат,
	УчетныйДокумент.Описание КАК Описание,
	ВЫБОР
		КОГДА УчетныйДокумент.ДатаИсполненияОбращения = ДАТАВРЕМЯ(1, 1, 1)
			ТОГДА РАЗНОСТЬДАТ(УчетныйДокумент.ДатаРегистрации, &amp;ТекущаяДата, ДЕНЬ)
		ИНАЧЕ РАЗНОСТЬДАТ(УчетныйДокумент.ДатаРегистрации, УчетныйДокумент.ДатаИсполненияОбращения, ДЕНЬ)
	КОНЕЦ КАК СрокФактДней,
	ВЫБОР
		КОГДА УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Удовлетворено)
				ИЛИ УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Разъяснено)
			ТОГДА 30
		КОГДА УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Перенаправлено)
			ТОГДА 7
		КОГДА УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.ОтказаноВУдовлетворении)
			ТОГДА 3
		ИНАЧЕ 30
	КОНЕЦ КАК СрокНормативныйДней,
	ВЫБОР
		КОГДА (УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Удовлетворено)
				ИЛИ УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Разъяснено))
				И РАЗНОСТЬДАТ(УчетныйДокумент.ДатаРегистрации, УчетныйДокумент.ДатаИсполненияОбращения, ДЕНЬ) &gt; 30
			ТОГДА 1
		КОГДА УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.Перенаправлено)
				И РАЗНОСТЬДАТ(УчетныйДокумент.ДатаРегистрации, УчетныйДокумент.ДатаИсполненияОбращения, ДЕНЬ) &gt; 7
			ТОГДА 1
		КОГДА УчетныйДокумент.РезультатОбращения = ЗНАЧЕНИЕ(Перечисление.РезультатыОбращений.ОтказаноВУдовлетворении)
				И РАЗНОСТЬДАТ(УчетныйДокумент.ДатаРегистрации, УчетныйДокумент.ДатаИсполненияОбращения, ДЕНЬ) &gt; 3
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК Просрочено
ИЗ
	Документ.УчетныйДокумент КАК УчетныйДокумент
ГДЕ
	УчетныйДокумент.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументов.ОбращенияГраждан)
	И УчетныйДокумент.ДатаРегистрации МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
	</dataSet>
	<totalField>
		<dataPath>Просрочено</dataPath>
		<expression>Сумма(Просрочено)</expression>
	</totalField>
	<totalField>
		<dataPath>СрокФактДней</dataPath>
		<expression>Сумма(СрокФактДней)</expression>
	</totalField>
	<parameter>
		<name>ТекущаяДата</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текущая дата</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<expression>ТекущаяДата()</expression>
	</parameter>
	<parameter>
		<name>КонецПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Конец периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Начало периода</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>Date</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>false</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:pal="http://v8.1c.ru/8.1/data/ui/colors/palette" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ВнешнийНомер</dcsset:field>
				</dcsset:item>
