&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    
    Если Объект.СтатусДокумента.Пустая() Тогда
    
        Объект.СтатусДокумента = Параметры.Статус;	
    
    КонецЕсли;
    
    Если Объект.ТипДокумента.Пустая() Тогда
    
        Объект.ТипДокумента = Параметры.ТипДок;	
    
    КонецЕсли;
    
    Если НЕ Объект.ТипДокумента = Перечисления.ТипыДокументов.ОбращенияГраждан Тогда
    
        Элементы.РезультатОбращения.Видимость = Ложь;	
    
    КонецЕсли;
    
    Если Объект.ТипДокумента = Перечисления.ТипыДокументов.ОбращенияГраждан ИЛИ Объект.ТипДокумента = Перечисления.ТипыДокументов.ВходящийДокумент Тогда
        
        Элементы.Исполнитель.Видимость = Ложь;
        Элементы.Корреспондент.Видимость = Истина;
        Элементы.Подписант.Видимость = Ложь;
        Элементы.ПодписантВХ.Видимость = Истина;
    
    КонецЕсли;
    
    Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
        ЗагрузитьСвязи();
    КонецЕсли;
    
    Если РольДоступна("АДМИНИСТРАТОР") ИЛИ РольДоступна("Прокурор") ИЛИ РольДоступна("АДМИНИСТРАТОР") Тогда
        Элементы.НазначитьИсполнителя.Видимость = Истина;	
    Иначе
        Элементы.НазначитьИсполнителя.Видимость = Ложь;
    КонецЕсли;
    
    УправлениеДоступностьюКнопок();
КонецПроцедуры

