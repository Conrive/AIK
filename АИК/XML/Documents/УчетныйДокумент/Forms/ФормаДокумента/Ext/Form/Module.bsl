&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
    // Создаем параметры диалога выбора файла с фильтром на PDF
    ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
    ПараметрыДиалога.МножественныйВыбор = Ложь;
    ПараметрыДиалога.Заголовок = "Выберите PDF-файл для загрузки";
    ПараметрыДиалога.Фильтр = "PDF-файлы (*.pdf)|*.pdf|Все файлы (*.*)|*.*";
    
    // Описание оповещения о завершении
    ОповещениеОЗавершении = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект);
    
    // Вызываем современный метод
    НачатьПомещениеФайлаНаСервер(
        ОповещениеОЗавершении,   // ОписаниеОповещенияОЗавершении
        ,                        // ОписаниеОповещенияОХодеВыполнения (не используем)
        ,                        // ОписаниеОповещенияПередНачалом (не используем)
        ,                        // Адрес (не указываем, будет диалог)
        ПараметрыДиалога,        // ПараметрыДиалога
        УникальныйИдентификатор  // УникальныйИдентификаторФормы
    );
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ОписаниеПомещенногоФайла, ДополнительныеПараметры) Экспорт
    Если ОписаниеПомещенногоФайла = Неопределено Тогда
        Возврат;
    КонецЕсли;
    ЗагрузитьФайлНаСервере(ОписаниеПомещенногоФайла.Адрес, ОписаниеПомещенногоФайла.СсылкаНаФайл.Расширение);
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлНаСервере(Адрес, Имя)
    Если ВРег(Имя) <> ".PDF" Тогда
        Сообщить("Допускается загрузка только файлов формата PDF.");
        Возврат;
    КонецЕсли;

    ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
    Если ДвоичныеДанные = Неопределено Тогда
        Сообщить("Не удалось получить файл.");
        Возврат;
    КонецЕсли;

    // Проверка сигнатуры %PDF- (защита от переименованных exe)
    Если Не ЭтоПДФПоСигнатуре(ДвоичныеДанные) Тогда
        Сообщить("Файл не является корректным PDF-документом.");
        Возврат;
    КонецЕсли;

    // Сохраняем прямо в реквизит документа
    Объект.СканДокумента = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
    //Объект.СканДокумента.Записать();

    ОбновитьПолеPDFНаСервере();
КонецПроцедуры

