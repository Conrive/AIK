&НаСервере
Процедура ОбновитьПолеPDFНаСервере()
  
    Если Объект.СканДокумента = Неопределено Тогда
        ПолеPDF = Новый ДокументPDF; // Пустое поле
        ЕстьФайл = Ложь;
        Элементы.КнопкаУдаленияФайла.Доступность = Ложь;
        Возврат;
    КонецЕсли;

    Попытка
        ДвоичныеДанные = Объект.СканДокумента.Получить();
        Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
        
        ДокументPDF = Новый ДокументPDF;
        ДокументPDF.Прочитать(Поток);
        ПолеPDF = ДокументPDF;
        
        ЕстьФайл = Истина;
        Элементы.КнопкаУдаленияФайла.Доступность = Истина;
    Исключение
        ПолеPDF = Новый ДокументPDF;
        ЕстьФайл = Ложь;
        Элементы.КнопкаУдаленияФайла.Доступность = Ложь;
        Сообщить("Не удалось прочитать PDF: " + ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

