&НаСервере
Процедура ЗагрузитьСвязи()
    ТаблицаСвязей.Очистить();
    МассивСвязей = СвязиДокументовСервер.ПолучитьСвязанныеДокументы(Объект.Ссылка);
    
    Для Каждого Строка Из МассивСвязей Цикл
        НоваяСтрока = ТаблицаСвязей.Добавить();
        НоваяСтрока.СвязанныйДокумент = Строка.СвязанныйДокумент;
        НоваяСтрока.ТипСвязи = Строка.ТипСвязи;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДокумента(ВыбранныйДокумент, ДополнительныеПараметры) Экспорт
    Если ВыбранныйДокумент = Неопределено Тогда
        Возврат;
    КонецЕсли;
    
    ДобавитьСвязьНаСервере(ВыбранныйДокумент);
КонецПроцедуры

&НаСервере
Процедура ДобавитьСвязьНаСервере(ВыбранныйДокумент)
    // Проверяем, есть ли уже такая связь в таблице
    Для Каждого Строка Из ТаблицаСвязей Цикл
        Если Строка.СвязанныйДокумент = ВыбранныйДокумент Тогда
            Сообщить("Этот документ уже добавлен в список связей.");
            Возврат;
        КонецЕсли;
    КонецЦикла;
    
    // Добавляем в таблицу на форме
    НоваяСтрока = ТаблицаСвязей.Добавить();
    НоваяСтрока.СвязанныйДокумент = ВыбранныйДокумент;
    НоваяСтрока.ТипСвязи = Перечисления.ТипыСвязейДокументов.ДляИсполненияИсполнено;
КонецПроцедуры

&НаСервере
Процедура СинхронизироватьСвязи()
    
    // Получаем текущие связи из БД
    ТекущиеСвязиБД = СвязиДокументовСервер.ПолучитьСвязанныеДокументы(Объект.Ссылка);
    
    // Собираем множество связанных документов из БД
    МножествоБД = Новый Массив;
    Для Каждого Строка Из ТекущиеСвязиБД Цикл
        МножествоБД.Добавить(Строка.СвязанныйДокумент);
    КонецЦикла;
    
    // Собираем множество документов из формы
    МножествоФормы = Новый Массив;
    Для Каждого Строка Из ТаблицаСвязей Цикл
        МножествоФормы.Добавить(Строка.СвязанныйДокумент);
    КонецЦикла;
    
    // 1. Удаляем те связи, которых больше нет на форме
    Для Каждого СтарыйДок Из МножествоБД Цикл
        Если МножествоФормы.Найти(СтарыйДок) = Неопределено Тогда
            СвязиДокументовСервер.УдалитьСвязь(Объект.Ссылка, СтарыйДок);
        КонецЕсли;
    КонецЦикла;
    
    // 2. Добавляем новые связи, которых нет в БД
    Для Каждого СтрокаФормы Из ТаблицаСвязей Цикл
        Если МножествоБД.Найти(СтрокаФормы.СвязанныйДокумент) = Неопределено Тогда
            СвязиДокументовСервер.ДобавитьСвязь(Объект.Ссылка, СтрокаФормы.СвязанныйДокумент, СтрокаФормы.ТипСвязи);
        КонецЕсли;
    КонецЦикла;
        
КонецПроцедуры

