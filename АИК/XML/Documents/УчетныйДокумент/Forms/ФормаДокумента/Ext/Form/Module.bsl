&НаСервере
Функция ЭтоПДФПоСигнатуре(ДвоичныеДанные)
    Если ДвоичныеДанные.Размер() < 5 Тогда
        Возврат Ложь;
    КонецЕсли;
    Поток = ДвоичныеДанные.ОткрытьПотокДляЧтения();
    Буфер = Новый БуферДвоичныхДанных(5);
    Поток.Прочитать(Буфер, 0, 5);
    Поток.Закрыть();
    // Сигнатура "%PDF-"
    Возврат Буфер[0] = 37 И Буфер[1] = 80 И Буфер[2] = 68 И Буфер[3] = 70 И Буфер[4] = 45;
КонецФункции

