&НаКлиенте
Процедура ПослеВыбораСотрудников(МассивСотрудников, ДополнительныеПараметры) Экспорт
    
    Если МассивСотрудников = Неопределено ИЛИ МассивСотрудников.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    // Отправляем на сервер
    ПереслатьНаСервере(МассивСотрудников);
    
КонецПроцедуры

&НаСервере
Процедура ПереслатьНаСервере(МассивСотрудников)
    
    // Получаем текущего сотрудника (отправителя)
    Отправитель = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    
    // Вызываем наш модуль
    ПересылкаДокументов.ПереслатьДокумент(Объект.Ссылка, МассивСотрудников, Отправитель);
    
    Сообщить("Документ переслан " + МассивСотрудников.Количество() + " сотрудникам.");
    
КонецПроцедуры

&НаСервере
Процедура ОзнакомленНаСервере()
    
    ТекущийСотрудник = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    
    ПересылкаДокументов.ОтметитьОзнакомление(Объект.Ссылка, ТекущийСотрудник);
    
    Сообщить("Документ отмечен как ознакомленный.");
    
КонецПроцедуры

