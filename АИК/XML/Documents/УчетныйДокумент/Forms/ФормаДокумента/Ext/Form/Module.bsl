// ---------- Машина состояний документа ----------

&НаСервере
Процедура УправлениеДоступностьюКнопок()
    
    // Сначала всё скрываем
    Элементы.КнопкаОтправитьНаПодпись.Видимость = Ложь;
    Элементы.КнопкаПодписать.Видимость = Ложь;
    Элементы.КнопкаВернутьНаДоработку.Видимость = Ложь;
    
    Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда Возврат; КонецЕсли;
    
    ТекущийСотрудник = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    Статус = Объект.СтатусДокумента;
    
    // 1. Проект -> На подпись
    // Отправлять может автор или любой офицер/прокурор
    Если Статус = Перечисления.СтатусыДокументов.ПроектДокумента 
       ИЛИ Статус = Перечисления.СтатусыДокументов.НеПодписан Тогда
       
        Если Объект.Регистратор = ТекущийСотрудник 
           ИЛИ РольДоступна("Прокурор") ИЛИ РольДоступна("АДМИНИСТРАТОР") Тогда // Предполагаем, что прокурор может отправлять чужие
            Элементы.КнопкаОтправитьНаПодпись.Видимость = Истина;
        КонецЕсли;
    КонецЕсли;
    
    // 2. На подписи -> Подписать или Вернуть
    Если Статус = Перечисления.СтатусыДокументов.НаПодписи Тогда
        
        // Подписывать может тот, кто указан в реквизите "Подписант" (или прокурор)
        Если (Объект.Подписант = ТекущийСотрудник) 
           ИЛИ (НЕ ЗначениеЗаполнено(Объект.Подписант) И РольДоступна("Прокурор")) ИЛИ РольДоступна("АДМИНИСТРАТОР") Тогда
            
            Элементы.КнопкаПодписать.Видимость = Истина;
            Элементы.КнопкаВернутьНаДоработку.Видимость = Истина;
        КонецЕсли;
    КонецЕсли;
    
    // 3. Готово к регистрации -> Зарегистрировать
    Если Статус = Перечисления.СтатусыДокументов.ГотовоКРегистрации Тогда
        
        // Регистрировать может только канцелярия
        Если РольДоступна("Канцеляр") ИЛИ РольДоступна("Прокурор") ИЛИ РольДоступна("АДМИНИСТРАТОР") Тогда
            Элементы.КнопкаЗарегистрировать.Видимость = Истина;
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПровестиИсполнениеНаСервере()
    
    ТекущийСотрудник = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    
    Попытка
        ПересылкаДокументов.ОтметитьИсполнениеПоручения(Объект.Ссылка, ТекущийСотрудник, ТекстОтчета);
        
        Сообщить("Исполнение успешно зафиксировано.");
        
    Исключение
        Сообщить("Ошибка при проведении исполнения: " + ОписаниеОшибки());
    КонецПопытки;
    
КонецПроцедуры 

&НаСервере
Процедура ОтправитьНаПодписьНаСервере()
    Попытка
        // Записываем объект, чтобы сохранить последние изменения
        Записать();
        МодульСтатусовДокумента.ОтправитьНаПодпись(Объект);
        Сообщить("Документ отправлен на подпись.");
        УправлениеДоступностьюКнопок();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПодписатьНаСервере()
    ТекущийСотрудник = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    Попытка
        МодульСтатусовДокумента.ПодписатьДокумент(Объект, ТекущийСотрудник);
        Сообщить("Документ подписан и готов к регистрации.");
        УправлениеДоступностьюКнопок();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ВернутьНаДоработкуНаСервере()
    Попытка
        МодульСтатусовДокумента.ВернутьНаДоработку(Объект);
        Сообщить("Документ возвращен на доработку.");
        УправлениеДоступностьюКнопок();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗарегистрироватьНаСервере()
    ТекущийСотрудник = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    Попытка
        МодульСтатусовДокумента.ЗарегистрироватьДокумент(Объект, ТекущийСотрудник);
        // После регистрации можно обновить форму, чтобы увидеть номер
        Записать();
        Сообщить("Документ зарегистрирован. Номер: " + Объект.ВнешнийНомер);
        УправлениеДоступностьюКнопок();
    Исключение
        Сообщить(ОписаниеОшибки());
    КонецПопытки;
КонецПроцедуры
