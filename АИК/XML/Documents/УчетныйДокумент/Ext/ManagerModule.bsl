////////////////////////////////////////////////////////////////////////////////
// Генерация внешнего номера документа.
//
// Алгоритм:
//   1. Определяем префикс по типу документа.
//   2. Блокируем запись регистра НумерацияДокументов по измерениям
//      (ТипДокумента, Год), чтобы исключить параллельную генерацию.
//   3. Увеличиваем счётчик на 1.
//   4. Формируем внешний номер: {Префикс}-{Номер}-{YY}.
//
// Параметры:
//   ТипДокумента - ПеречислениеСсылка.ТипыДокументов - тип документа.
//   Год          - Число - год регистрации (4 цифры). По умолчанию — текущий.
//
// Возвращаемое значение:
//   Строка - внешний номер, например "ИСХ-1-26".
//
Функция СгенерироватьВнешнийНомер(ТипДокумента, Год = 0) Экспорт

	Если НЕ ЗначениеЗаполнено(ТипДокумента) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан тип документа для генерации внешнего номера.'");
	КонецЕсли;

	Если Год = 0 Тогда
		Год = Год(ТекущаяДатаСеанса());
	КонецЕсли;

	// 1. Префикс
	Префикс = ПрефиксПоТипуДокумента(ТипДокумента);

	// 2. Блокировка + чтение + инкремент
	ПорядковыйНомер = СледующийНомерПоТипу(ТипДокумента, Год);

	// 3. Формируем внешний номер
	ДвеЦифрыГода = Прав(Формат(Год, "ЧГ=0"), 2);

	Возврат Префикс + "-" + Формат(ПорядковыйНомер, "ЧГ=0") + "-" + ДвеЦифрыГода;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Возвращает префикс внешнего номера по типу документа.
//
Функция ПрефиксПоТипуДокумента(ТипДокумента) Экспорт

	Соответствие = СоответствиеПрефиксов();

	Префикс = Соответствие.Получить(ТипДокумента);
	Если Префикс = Неопределено Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Не задан префикс внешнего номера для типа документа ""%1"".'"),
			Строка(ТипДокумента));
	КонецЕсли;

	Возврат Префикс;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Возвращает соответствие "Тип документа -> Префикс".
//
Функция СоответствиеПрефиксов() Экспорт

	Соответствие = Новый Соответствие;

	Соответствие.Вставить(Перечисления.ТипыДокументов.ВходящийДокумент,             "ВХ");
	Соответствие.Вставить(Перечисления.ТипыДокументов.ИсходящийДокумент,            "ИСХ");
	Соответствие.Вставить(Перечисления.ТипыДокументов.ОбращенияГраждан,             "ОБР");
	Соответствие.Вставить(Перечисления.ТипыДокументов.ОтветНаОбращение,             "ОТВ");
	Соответствие.Вставить(Перечисления.ТипыДокументов.ПеренаправлениеОбращение,     "ПЕР");
	Соответствие.Вставить(Перечисления.ТипыДокументов.АктПрокурорскогоРеагирования, "АПР");
	Соответствие.Вставить(Перечисления.ТипыДокументов.ВнутреннийДокумент,           "ВН");

	Возврат Соответствие;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Атомарно увеличивает счётчик для пары (ТипДокумента, Год) и возвращает
// новое значение. Использует управляемую блокировку, чтобы исключить
// параллельную генерацию одинаковых номеров.
//
Функция СледующийНомерПоТипу(ТипДокумента, Год) Экспорт

	// Блокируем именно эту комбинацию измерений.
	// Второй параметр Истина — блокировать без ожидания освобождения
	// другими сеансами (при конфликте получим исключение "Ошибка блокировки").
	// Если нужно ждать — передайте Ложь.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НумерацияДокументов");
	ЭлементБлокировки.УстановитьЗначение("ТипДокумента", ТипДокумента);
	ЭлементБлокировки.УстановитьЗначение("Год", Год);
	Блокировка.Заблокировать();

	Попытка

		// Читаем текущее значение счётчика
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НумерацияДокументов.ПоследнийНомер КАК ПоследнийНомер
		|ИЗ
		|	РегистрСведений.НумерацияДокументов КАК НумерацияДокументов
		|ГДЕ
		|	НумерацияДокументов.ТипДокумента = &ТипДокумента
		|	И НумерацияДокументов.Год = &Год";
		Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
		Запрос.УстановитьПараметр("Год", Год);

		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоследнийНомер = Выборка.ПоследнийНомер;
		Иначе
			ПоследнийНомер = 0;
		КонецЕсли;

		НовыйНомер = ПоследнийНомер + 1;

		// Записываем новое значение
		НаборЗаписей = РегистрыСведений.НумерацияДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ТипДокумента.Установить(ТипДокумента);
		НаборЗаписей.Отбор.Год.Установить(Год);

		Запись = НаборЗаписей.Добавить();
		Запись.ТипДокумента = ТипДокумента;
		Запись.Год = Год;
		Запись.ПоследнийНомер = НовыйНомер;

		НаборЗаписей.Записать();

		Возврат НовыйНомер;

	Исключение

		// Пробрасываем исключение дальше — транзакция откатится,
		// внешний номер не будет присвоен.
		ВызватьИсключение;

	КонецПопытки;

КонецФункции