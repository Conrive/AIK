Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    // Если документ только что создан — фиксируем автора.
    Если ЭтоНовый() И НЕ ЗначениеЗаполнено(Регистратор) Тогда       
        Регистратор = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    КонецЕсли;

    // Генерируем внешний номер в момент перехода в статус "Зарегистрирован",
    // если он ещё не присвоен.
    Если СтатусДокумента = Перечисления.СтатусыДокументов.Зарегистрировано
    	И НЕ ЗначениеЗаполнено(ВнешнийНомер) Тогда

    	// Дата регистрации: если не указана — ставим текущую.
    	Если НЕ ЗначениеЗаполнено(ДатаРегистрации) Тогда
    		ДатаРегистрации = ТекущаяДатаСеанса();
    	КонецЕсли;

    	ВнешнийНомер = Документы.УчетныйДокумент.СгенерироватьВнешнийНомер(
    		ТипДокумента,
    		Год(ДатаРегистрации));

    КонецЕсли;
        
    // Фиксация даты исполнения обращения
    Если ТипДокумента = Перечисления.ТипыДокументов.ОбращенияГраждан 
        И ЗначениеЗаполнено(РезультатОбращения)
        И НЕ ЗначениеЗаполнено(ДатаИсполненияОбращения) Тогда
        
        ДатаИсполненияОбращения = ТекущаяДатаСеанса();
                
    КонецЕсли;   
КонецПроцедуры


