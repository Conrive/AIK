
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Параметры.Свойство("ТекстУсловия") Тогда
        
        // 1. Берём текущий текст запроса динамического списка
        // (он у вас сохранён в конфигураторе с &ТекстУсловия)
        ТекстЗапроса = СписокДокументов.ТекстЗапроса;
        
        // 2. Заменяем заглушку &ТекстУсловия на реальное условие
        // ВАЖНО: здесь мы делаем СтрЗаменить, а не передаём параметр!
        ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстУсловия", Параметры.ТекстУсловия);
        
        // 3. Присваиваем обратно
        СписокДокументов.ТекстЗапроса = ТекстЗапроса;
        
    КонецЕсли;
    
КонецПроцедуры


