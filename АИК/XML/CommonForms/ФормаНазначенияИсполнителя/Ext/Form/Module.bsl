
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Если Параметры.Свойство("Документ") Тогда
        Документ = Параметры.Документ;
        ЗагрузитьТекущихИсполнителей();
    КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТекущихИсполнителей()
    
    ТаблицаИсполнителей.Очистить();
    Массив = ИсполнениеДокументовСервер.ПолучитьОтветственных(Документ);
    
    Для Каждого Строка Из Массив Цикл
        НоваяСтрока = ТаблицаИсполнителей.Добавить();
        НоваяСтрока.Сотрудник = Строка.Сотрудник;
        НоваяСтрока.СрокИсполнения = Строка.СрокИсполнения;
        НоваяСтрока.Комментарий = Строка.Комментарий;
    КонецЦикла;
    
КонецПроцедуры

&НаКлиенте
Процедура Назначить(Команда)
    // Проверка: должны быть выбраны сотрудники
    Если ТаблицаИсполнителей.Количество() = 0 Тогда
        ПоказатьПредупреждение(, "Добавьте хотя бы одного ответственного исполнителя.");
        Возврат;
    КонецЕсли;
    
    Для Каждого Строка Из ТаблицаИсполнителей Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) Тогда
            ПоказатьПредупреждение(, "Укажите сотрудника для каждой строки.");
            Возврат;
        КонецЕсли;
    КонецЦикла;
    
    НазначитьНаСервере();
    Закрыть();
КонецПроцедуры 

&НаСервере
Процедура НазначитьНаСервере()
    
    // Получаем текущего прокурора
    Прокурор = МодульКонфигурации.СотрудникиПоТекущемуПользователю();
    
    // Собираем массив сотрудников
    МассивСотрудников = Новый Массив;
    Для Каждого Строка Из ТаблицаИсполнителей Цикл
        МассивСотрудников.Добавить(Строка);
    КонецЦикла;
    
    // Вызываем серверный метод
    ИсполнениеДокументовСервер.НазначитьОтветственногоИсполнителя(
        Документ, МассивСотрудников, Прокурор);
    
    // Закрываем форму
    Сообщить("Ответственные исполнители назначены.");
    
КонецПроцедуры
