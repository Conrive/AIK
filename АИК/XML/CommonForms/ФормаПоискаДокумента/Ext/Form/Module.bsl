
&НаКлиенте
Процедура КнопкаНайти(Команда)
    
    СобранныйЗапрос = СформироватьТекстЗапроса();

    ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ТекстУсловия", СобранныйЗапрос);
	
    ФормаРезультатов = ПолучитьФорму("ОбщаяФорма.РезультатыПоиска", ПараметрыФормы, ЭтаФорма);
    ФормаРезультатов.Открыть();
КонецПроцедуры

&НаСервере
Функция СформироватьТекстЗапроса()
    
    // 1. Группируем условия по полям
    ГруппыУсловий = Новый Соответствие;
    
    Для Каждого Строка Из ТаблицаФильтров Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Поле) ИЛИ НЕ ЗначениеЗаполнено(Строка.Значение) Тогда
            Продолжить;
        КонецЕсли;
        
        ИмяПоля = Строка.Поле;
        
        Если ГруппыУсловий.Получить(ИмяПоля) = Неопределено Тогда
            ГруппыУсловий.Вставить(ИмяПоля, Новый Массив);
        КонецЕсли;
        
        ГруппыУсловий[ИмяПоля].Добавить(Строка);
    КонецЦикла;
    
    // 2. Формируем SQL-строки
    МассивГруппSQL = Новый Массив;
    
    Для Каждого ЭлементГруппы Из ГруппыУсловий Цикл
        ИмяПоля = ЭлементГруппы.Ключ;
        МассивСтрокТаблицы = ЭлементГруппы.Значение;
        
        ПутьSQL = ПолучитьПутьПоляSQL(ИмяПоля); // См. предыдущий ответ
        
        МассивПодстрок = Новый Массив;
        
        Для Каждого СтрокаФильтра Из МассивСтрокТаблицы Цикл
            
            ВидСравненияДокумента = СтрокаФильтра.ВидСравнения;
            ЗначениеSQL = СформироватьSQLЛитерал(СтрокаФильтра.Значение, ВидСравненияДокумента);
            
            Если ВидСравненияДокумента = "Равно" Тогда
                ПодстрокаSQL = СтрШаблон("%1 = %2", ПутьSQL, ЗначениеSQL);
                
            ИначеЕсли ВидСравненияДокумента = "Не равно" Тогда
                ПодстрокаSQL = СтрШаблон("%1 <> %2", ПутьSQL, ЗначениеSQL);
                
            ИначеЕсли ВидСравненияДокумента = "Содержит" Тогда
                // ПОДОБНО работает только со строками, приведём к строке
                ПодстрокаSQL = СтрШаблон("ПОДСТРОКА(%1, 1, 1000) ПОДОБНО %2", ПутьSQL, ЗначениеSQL);
                
            ИначеЕсли ВидСравненияДокумента = "Не содержит" Тогда
                ПодстрокаSQL = СтрШаблон("ПОДСТРОКА(%1, 1, 1000) НЕ ПОДОБНО %2", ПутьSQL, ЗначениеSQL);
                
            ИначеЕсли ВидСравненияДокумента = "Больше" Тогда
                ПодстрокаSQL = СтрШаблон("%1 > %2", ПутьSQL, ЗначениеSQL);
                
            ИначеЕсли ВидСравненияДокумента = "Меньше" Тогда
                ПодстрокаSQL = СтрШаблон("%1 < %2", ПутьSQL, ЗначениеSQL);
                
            Иначе
                Продолжить; // Неизвестный оператор — пропускаем
            КонецЕсли;
            
            МассивПодстрок.Добавить(ПодстрокаSQL);
        КонецЦикла;
        
        // Если для поля несколько значений — объединяем через ИЛИ
        Если МассивПодстрок.Количество() > 0 Тогда
            ГруппаSQL = "(" + СтрСоединить(МассивПодстрок, " ИЛИ ") + ")";
            МассивГруппSQL.Добавить(ГруппаSQL);
        КонецЕсли;
    КонецЦикла;
    
    // 3. Склеиваем группы через И
    Если МассивГруппSQL.Количество() > 0 Тогда
        Возврат СтрСоединить(МассивГруппSQL, " И ");
    Иначе
        Возврат "ИСТИНА"; // Если фильтров нет — вернуть все
    КонецЕсли;
КонецФункции

&НаСервере
Функция СформироватьSQLЛитерал(Значение, ВидСравнения)
    
    Если Значение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Значение) Тогда
        Возврат "NULL";
    КонецЕсли;
    
    ТипЗначения = ТипЗнч(Значение);
    
    Если ТипЗначения = Тип("Строка") Тогда
        // Для операторов "Содержит" и "Не содержит" оборачиваем в %
        Если ВидСравнения = "Содержит" Тогда
            Значение = "%" + Значение + "%";
        ИначеЕсли ВидСравнения = "Не содержит" Тогда
            Значение = "%" + Значение + "%";
        КонецЕсли;
        
        Возврат """" + СтрЗаменить(Значение, """", """""") + """";
        
    ИначеЕсли ТипЗначения = Тип("Число") Тогда
        Возврат Формат(Значение, "ЧГ=0.000");
        
    ИначеЕсли ТипЗначения = Тип("Дата") Тогда
        // Формат даты в 1С: ДАТАВРЕМЯ(Год, Месяц, День, Час, Минута, Секунда)
        Возврат СтрШаблон("ДАТАВРЕМЯ(%1, %2, %3, %4, %5, %6)",
            Год(Значение), Месяц(Значение), День(Значение),
            Час(Значение), Минута(Значение), Секунда(Значение));
            
    ИначеЕсли ТипЗначения = Тип("Булево") Тогда
        Если Значение = Истина Тогда
            Возврат "ИСТИНА";
        Иначе
            Возврат "ЛОЖЬ";
        КонецЕсли;
        
    ИначеЕсли ТипЗначения = Тип("ПеречислениеСсылка.ТипыДокументов") 
        ИЛИ ТипЗначения = Тип("ПеречислениеСсылка.РезультатыОбращений") Тогда
        // 1. Получаем объект метаданных перечисления по его типу
        МетаданныеПеречисления = Метаданные.НайтиПоТипу(ТипЗначения);
        
        // 2. Имя перечисления в метаданных (например, "ТипыДокументов")
        ИмяПеречисления = МетаданныеПеречисления.Имя;
        
        // 3. Имя значения в метаданных. 
        ИмяЗначения = "";
        Для Каждого ЗначениеМетаданных Из МетаданныеПеречисления.ЗначенияПеречисления Цикл
            // Сравниваем текущее значение с элементом метаданных
            Если Строка(Значение) = ЗначениеМетаданных.Синоним Тогда
                ИмяЗначения = ЗначениеМетаданных.Имя;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        
        // 4. Собираем корректный литерал для запроса
        Возврат "ЗНАЧЕНИЕ(Перечисление." + ИмяПеречисления + "." + ИмяЗначения + ")";
        
    ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ПрокурорскиеРаботники") 
        ИЛИ ТипЗначения = Тип("СправочникСсылка.Корреспонденты") Тогда
    
        // 1. Получаем метаданные справочника
        МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипЗначения);
        ИмяСправочника = МетаданныеСправочника.Имя;
        
        // 2. Получаем UUID ссылки (уникальный идентификатор)
        УникальныйИдентификатор = Значение.УникальныйИдентификатор();
        
        // 3. Собираем литерал для запроса
        Возврат "ЗНАЧЕНИЕ(Справочник." + ИмяСправочника + "." + УникальныйИдентификатор + ")";
            
    Иначе
        // Фоллбэк: пробуем привести к строке
        Возврат "'" + СтрЗаменить(Строка(Значение), "'", "''") + "'";
    КонецЕсли;
    
КонецФункции

&НаСервере
Функция ПолучитьПутьПоляSQL(ИмяПоля)
    // Возвращает алиас поля для SQL-запроса
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("Тип документа",      "УчетныйДокумент.ТипДокумента");
    Соответствие.Вставить("Номер",              "УчетныйДокумент.ВнешнийНомер");
    Соответствие.Вставить("Описание",           "УчетныйДокумент.Описание");
    Соответствие.Вставить("Исполнитель",        "УчетныйДокумент.Исполнитель");
    Соответствие.Вставить("Корреспондент",      "УчетныйДокумент.Корреспондент");
    Соответствие.Вставить("Дата регистрации",   "УчетныйДокумент.ДатаРегистрации");
    Соответствие.Вставить("Подписант",          "УчетныйДокумент.Подписант");
    Соответствие.Вставить("ОснАдресат",            "УчетныйДокумент.ОснАдресат");
    Соответствие.Вставить("Результат",          "УчетныйДокумент.РезультатОбращения");
    
    Путь = Соответствие.Получить(ИмяПоля);
    Если Путь = Неопределено Тогда
        ВызватьИсключение "Недопустимое поле фильтра: " + ИмяПоля;
    КонецЕсли;
    
    Возврат Путь;
КонецФункции


&НаКлиенте
Процедура ТаблицаФильтровПолеОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, ВыборДобавлением, СтандартнаяОбработка)
    
    Если НЕ ПустаяСтрока(ВыбранноеЗначение) Тогда
    
        Элементы.ТаблицаФильтровВидСравнения.Доступность = Истина;
        Элементы.ТаблицаФильтровЗначение.Доступность = Истина;
        Элементы.ТаблицаФильтровЛогикаСвязи.Доступность = Истина;

    КонецЕсли;
    
КонецПроцедуры

Функция ПолучитьТипПоПараметру(Параметр)
    // Возвращает объект Тип, соответствующий параметру
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("Тип документа",      Тип("ПеречислениеСсылка.ТипыДокументов"));
    Соответствие.Вставить("Номер",              Тип("Строка"));
    Соответствие.Вставить("Описание",           Тип("Строка"));
    Соответствие.Вставить("Исполнитель",        Тип("СправочникСсылка.ПрокурорскиеРаботники"));
    Соответствие.Вставить("Корреспондент",      Тип("СправочникСсылка.Корреспонденты"));
    Соответствие.Вставить("Дата регистрации",   Тип("Дата"));
    Соответствие.Вставить("Подписант",          Тип("СправочникСсылка.ПрокурорскиеРаботники"));
    Соответствие.Вставить("ОснАдресат",         Тип("СправочникСсылка.Корреспонденты"));
    Соответствие.Вставить("Результат",          Тип("ПеречислениеСсылка.РезультатыОбращений"));

    Возврат Соответствие[Параметр];
КонецФункции


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ТаблицаФильтров.Добавить();
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаФильтровЗначениеПриИзменении(Элемент)
    ТекСтрока = Элементы.ТаблицаФильтров.ТекущиеДанные;
    Если ТекСтрока = Неопределено Тогда
        Возврат;
    КонецЕсли; 
    
    ОжидаемыйТип = ПолучитьТипПоПараметру(ТекСтрока.Поле);
    
    ГСЧ = Новый ГенераторСлучайныхЧисел(ТекущаяУниверсальнаяДатаВМиллисекундах());
    СлЧ = ГСЧ.СлучайноеЧисло(1, 5);
    Если Слч = 1 Тогда
        ТекстЗаголовка = "Ошибка! Код: ANY_KEY";	
    ИначеЕсли СлЧ = 2 Тогда 
        ТекстЗаголовка = "Ошибка! Код: OSI_L8";
    ИначеЕсли СлЧ = 3 Тогда 
        ТекстЗаголовка = "Ошибка! Код: ID-10T";
    ИначеЕсли СлЧ = 4 Тогда 
        ТекстЗаголовка = "Ошибка! Код: PEBKAC";
    ИначеЕсли СлЧ = 5 Тогда 
        ТекстЗаголовка = "Ошибка! Код: IBM error";
    КонецЕсли;
    
    Если ЗначениеЗаполнено(ТекСтрока.Значение) И ТипЗнч(ТекСтрока.Значение) <> ОжидаемыйТип Тогда
        ПоказатьПредупреждение(, "Некорректный тип значения для параметра """ + ТекСтрока.Поле + """",,ТекстЗаголовка);
        ТекСтрока.Значение = Неопределено;    
    КонецЕсли;
КонецПроцедуры
 

