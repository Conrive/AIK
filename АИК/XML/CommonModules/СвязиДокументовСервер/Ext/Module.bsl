// Общий модуль СвязиДокументовСервер

// Записывает связь между документами (принцип двойной записи)
Процедура ДобавитьСвязь(Документ1, Документ2, ТипСвязи = Неопределено) Экспорт
    
    Если ТипСвязи = Неопределено Тогда
        ТипСвязи = Перечисления.ТипыСвязейДокументов.ДляИсполненияИсполнено;
    КонецЕсли;

    // Нельзя связывать документ сам с собой
    Если Документ1 = Документ2 Тогда
        ВызватьИсключение "Нельзя связать документ с самим собой.";
    КонецЕсли;

    // Проверяем, нет ли уже такой связи
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ ПЕРВЫЕ 1
    |	СвязанныеДокументы.Документ1
    |ИЗ
    |	РегистрСведений.СвязанныеДокументы КАК СвязанныеДокументы
    |ГДЕ
    |	(СвязанныеДокументы.Документ1 = &Док1 И СвязанныеДокументы.Документ2 = &Док2)
    |	ИЛИ (СвязанныеДокументы.Документ1 = &Док2 И СвязанныеДокументы.Документ2 = &Док1)";
    Запрос.УстановитьПараметр("Док1", Документ1);
    Запрос.УстановитьПараметр("Док2", Документ2);
    
    Если НЕ Запрос.Выполнить().Пустой() Тогда
        Возврат; // Связь уже есть
    КонецЕсли;

    // Записываем двойную связь
    НаборЗаписей = РегистрыСведений.СвязанныеДокументы.СоздатьНаборЗаписей();
    
    // Прямая связь
    МенеджерЗаписи = РегистрыСведений.СвязанныеДокументы.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.Документ1 = Документ1;
    МенеджерЗаписи.Документ2 = Документ2;
    МенеджерЗаписи.ТипСвязи = ТипСвязи;
    МенеджерЗаписи.Записать();
    
    // Обратная связь
    МенеджерЗаписи = РегистрыСведений.СвязанныеДокументы.СоздатьМенеджерЗаписи();
    МенеджерЗаписи.Документ1 = Документ2;
    МенеджерЗаписи.Документ2 = Документ1;
    МенеджерЗаписи.ТипСвязи = ТипСвязи;
    МенеджерЗаписи.Записать();
КонецПроцедуры

// Удаляет связь (двойная запись)
Процедура УдалитьСвязь(Документ1, Документ2) Экспорт
    
    НаборЗаписей = РегистрыСведений.СвязанныеДокументы.СоздатьНаборЗаписей();
    
    // Отбор по первой паре
    НаборЗаписей.Отбор.Документ1.Установить(Документ1);
    НаборЗаписей.Отбор.Документ2.Установить(Документ2);
    НаборЗаписей.Записать(); // Пустой набор удаляет записи
    
    // Отбор по второй паре
    НаборЗаписей = РегистрыСведений.СвязанныеДокументы.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Документ1.Установить(Документ2);
    НаборЗаписей.Отбор.Документ2.Установить(Документ1);
    НаборЗаписей.Записать();
    
КонецПроцедуры

// Получает массив связанных документов
Функция ПолучитьСвязанныеДокументы(Документ) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	СвязанныеДокументы.Документ2 КАК СвязанныйДокумент,
    |	СвязанныеДокументы.ТипСвязи КАК ТипСвязи
    |ИЗ
    |	РегистрСведений.СвязанныеДокументы КАК СвязанныеДокументы
    |ГДЕ
    |	СвязанныеДокументы.Документ1 = &Документ";
    Запрос.УстановитьПараметр("Документ", Документ);
    
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции  

// Удаляет связь при удалении документа
Процедура ПередУдалениемУчетногоДокументаПередУдалением(Источник, Отказ) Экспорт
    // Получаем все связи удаляемого документа
    МассивСвязей = ПолучитьСвязанныеДокументы(Источник.Ссылка);
    
    Для Каждого Строка Из МассивСвязей Цикл
        // Удаляем связь в обе стороны
        УдалитьСвязь(Источник.Ссылка, Строка.СвязанныйДокумент);
    КонецЦикла;
КонецПроцедуры
