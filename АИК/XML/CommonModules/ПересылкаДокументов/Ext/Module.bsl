
Процедура ПереслатьДокумент(Документ, МассивСотрудников, Отправитель) Экспорт
    
    Если МассивСотрудников.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    
    Для Каждого Сотрудник Из МассивСотрудников Цикл
        
        НаборЗаписей = РегистрыСведений.СтатусыОзнакомления.СоздатьНаборЗаписей();
        
        НаборЗаписей.Отбор.Документ.Установить(Документ);
        НаборЗаписей.Отбор.Пользователь.Установить(Сотрудник);
        
        Запись = НаборЗаписей.Добавить();
        Запись.Документ = Документ;
        Запись.Пользователь = Сотрудник;
        Запись.ДатаПересылки = ТекущаяДатаСеанса();
        Запись.Отправитель = Отправитель;
        Запись.Ознакомлен = Ложь;
        Запись.ДатаОзнакомления = '00010101';
        
        НаборЗаписей.Записать();
        
    КонецЦикла;
    
КонецПроцедуры

Процедура ОтметитьОзнакомление(Документ, Пользователь) Экспорт
    
    НаборЗаписей = РегистрыСведений.СтатусыОзнакомления.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Документ.Установить(Документ);
    НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
    
    Запись = НаборЗаписей.Добавить();
    Запись.Документ = Документ;
    Запись.Пользователь = Пользователь;
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	СтатусыОзнакомления.ДатаПересылки,
    |	СтатусыОзнакомления.Отправитель
    |ИЗ
    |	РегистрСведений.СтатусыОзнакомления КАК СтатусыОзнакомления
    |ГДЕ
    |	СтатусыОзнакомления.Документ = &Документ
    |	И СтатусыОзнакомления.Пользователь = &Пользователь";
    Запрос.УстановитьПараметр("Документ", Документ);
    Запрос.УстановитьПараметр("Пользователь", Пользователь);
    
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда
        Запись.ДатаПересылки = Выборка.ДатаПересылки;
        Запись.Отправитель = Выборка.Отправитель;
    КонецЕсли;
    
    Запись.Ознакомлен = Истина;
    Запись.ДатаОзнакомления = ТекущаяДатаСеанса();
    
    НаборЗаписей.Записать();
    
КонецПроцедуры

Функция ПолучитьНовыеДокументы(Пользователь) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	СтатусыОзнакомления.Документ КАК Документ
    |ИЗ
    |	РегистрСведений.СтатусыОзнакомления КАК СтатусыОзнакомления
    |ГДЕ
    |	СтатусыОзнакомления.Пользователь = &Пользователь
    |	И СтатусыОзнакомления.Ознакомлен = ЛОЖЬ";
    Запрос.УстановитьПараметр("Пользователь", Пользователь);
    
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции

Процедура ОтметитьИсполнениеПоручения(Документ, Сотрудник, ТекстОтчета = "") Экспорт
    
    // Ищем запись в регистре
    НаборЗаписей = РегистрыСведений.ОтветственныеИсполнители.СоздатьНаборЗаписей();
    НаборЗаписей.Отбор.Документ.Установить(Документ);
    НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);
    
    // Читаем существующую запись
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	ОтветственныеИсполнители.ДатаНазначения,
    |	ОтветственныеИсполнители.Назначил,
    |	ОтветственныеИсполнители.СрокИсполнения,
    |	ОтветственныеИсполнители.Комментарий,
    |	ОтветственныеИсполнители.Исполнено,
    |	ОтветственныеИсполнители.ДатаИсполнения
    |ИЗ
    |	РегистрСведений.ОтветственныеИсполнители КАК ОтветственныеИсполнители
    |ГДЕ
    |	ОтветственныеИсполнители.Документ = &Документ
    |	И ОтветственныеИсполнители.Сотрудник = &Сотрудник";
    Запрос.УстановитьПараметр("Документ", Документ);
    Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
    
    Выборка = Запрос.Выполнить().Выбрать();
    
    Если НЕ Выборка.Следующий() Тогда
        ВызватьИсключение "Сотрудник не назначен ответственным исполнителем по этому документу.";
    КонецЕсли;
    
    // Если уже исполнено — не даем перезаписать (или можно разрешить, это бизнес-логика)
    Если Выборка.Исполнено Тогда
        ВызватьИсключение "Поручение уже отмечено как исполненное.";
    КонецЕсли;
    
    // Формируем запись с обновленными данными
    Запись = НаборЗаписей.Добавить();
    Запись.Документ = Документ;
    Запись.Сотрудник = Сотрудник;
    Запись.ДатаНазначения = Выборка.ДатаНазначения;
    Запись.Назначил = Выборка.Назначил;
    Запись.СрокИсполнения = Выборка.СрокИсполнения;
    Запись.Комментарий = Выборка.Комментарий;
    
    Запись.Исполнено = Истина;
    Запись.ДатаИсполнения = ТекущаяДатаСеанса();

    
    НаборЗаписей.Записать();
        
КонецПроцедуры
