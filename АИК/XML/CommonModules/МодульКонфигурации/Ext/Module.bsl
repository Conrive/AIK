
// ---------- Методы открытия форм ----------

&НаКлиенте
Процедура ОткрытьФормуУчетногоДокумента(Статус, Тип) Экспорт
    
    П = Новый Структура;
    П.Вставить("Статус", Статус);
    П.Вставить("ТипДок", Тип);
    Форма = ПолучитьФорму("Документ.УчетныйДокумент.Форма.ФормаДокумента", П);
    Форма.Открыть();	

КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуВыбораТипаДокумента(Статус) Экспорт
    
    П = Новый Структура("Статус", Статус);
    Форма = ПолучитьФорму("ОбщаяФорма.ФормаВыбораТипаДокумента", П);
    Форма.Открыть();	

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПоиска() Экспорт

    Форма = ПолучитьФорму("ОбщаяФорма.ФормаПоискаДокумента");
    Форма.Открыть();	

КонецПроцедуры 

// ---------- Возврат Справочники.ПрокурорскиеРаботники по текущему пользователю ----------

&НаСервере
Функция СотрудникиПоТекущемуПользователю() Экспорт 

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Работники.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПрокурорскиеРаботники КАК Работники
	|ГДЕ
	|	Работники.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь().Имя);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Справочники.ПрокурорскиеРаботники.ПустаяСсылка();

КонецФункции


