// Назначает ответственного исполнителя
Процедура НазначитьОтветственногоИсполнителя(Документ, МассивСтрок, Назначил, СрокИсполнения = '00010101', Комментарий = "") Экспорт
    
    МассивСотрудников = Новый Массив;
    НаборЗаписей = РегистрыСведений.ОтветственныеИсполнители.СоздатьНаборЗаписей();
    
    // Очищаем старые записи по этому документу (если переназначаем)
    НаборЗаписей.Отбор.Документ.Установить(Документ);
    НаборЗаписей.Записать(); // Пустой набор = удаление
    
    // Записываем новых
    Для Каждого Строка Из МассивСтрок Цикл
        НаборЗаписей = РегистрыСведений.ОтветственныеИсполнители.СоздатьНаборЗаписей();
        
        НаборЗаписей.Отбор.Документ.Установить(Документ);
        НаборЗаписей.Отбор.Сотрудник.Установить(Строка.Сотрудник);
        
        Запись = НаборЗаписей.Добавить();
        
        Запись.Документ = Документ;
        Запись.Сотрудник = Строка.Сотрудник;
        Запись.ДатаНазначения = ТекущаяДатаСеанса();
        Запись.Назначил = Назначил;
        Запись.СрокИсполнения = Строка.СрокИсполнения;
        Запись.Комментарий = Строка.Комментарий;
        
        МассивСотрудников.Добавить(Строка.Сотрудник);
        
        НаборЗаписей.Записать();
    КонецЦикла;
    
    ПересылкаДокументов.ПереслатьДокумент(Документ, МассивСотрудников, Назначил);
КонецПроцедуры

// Получает массив ответственных
Функция ПолучитьОтветственных(Документ) Экспорт
    
    Запрос = Новый Запрос;
    Запрос.Текст = 
    "ВЫБРАТЬ
    |	ОтветственныеИсполнители.Сотрудник КАК Сотрудник,
    |	ОтветственныеИсполнители.ДатаНазначения КАК ДатаНазначения,
    |	ОтветственныеИсполнители.СрокИсполнения КАК СрокИсполнения,
    |	ОтветственныеИсполнители.Комментарий КАК Комментарий
    |ИЗ
    |	РегистрСведений.ОтветственныеИсполнители КАК ОтветственныеИсполнители
    |ГДЕ
    |	ОтветственныеИсполнители.Документ = &Документ";
    Запрос.УстановитьПараметр("Документ", Документ);
    
    Возврат Запрос.Выполнить().Выгрузить();
    
КонецФункции