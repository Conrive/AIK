// 1. Отправить на подпись
Процедура ОтправитьНаПодпись(Документ) Экспорт
    
    // Проверка: отправлять может только автор или тот, у кого есть права
    Если НЕ Документ.СтатусДокумента = Перечисления.СтатусыДокументов.ПроектДокумента И НЕ Документ.СтатусДокумента = Перечисления.СтатусыДокументов.НеПодписан Тогда
        ВызватьИсключение "На подпись можно отправить только проект документа.";
    КонецЕсли;
    
    
    
    // Меняем статус
    // Автоматически пересылаем подписанту (если он указан в реквизите "Подписант")
    Если ЗначениеЗаполнено(Документ.Подписант) Тогда
        Документ.СтатусДокумента = Перечисления.СтатусыДокументов.НаПодписи;
        МассивСотрудников = Новый Массив;
        МассивСотрудников.Добавить(Документ.Подписант);
        ПересылкаДокументов.ПереслатьДокумент(Документ.Ссылка, МассивСотрудников, Документ.Регистратор);
    Иначе 
        ВызватьИсключение "Реквизит Подписант не может буть пустым";
    КонецЕсли;
    
КонецПроцедуры

// 2. Подписать документ
Процедура ПодписатьДокумент(Документ, Подписант) Экспорт
    
    Если Документ.СтатусДокумента <> Перечисления.СтатусыДокументов.НаПодписи Тогда
        ВызватьИсключение "Подписать можно только документ, находящийся на подписи.";
    КонецЕсли;
    
    // Проверка: подписывает именно тот, кто указан в реквизите "Подписант"
    // (Или если подписант не указан — любой, у кого есть права)
    Если ЗначениеЗаполнено(Документ.Подписант) И Документ.Подписант <> Подписант Тогда
        ВызватьИсключение "Вы не являетесь подписантом по этому документу.";
    КонецЕсли;
    
    Документ.СтатусДокумента = Перечисления.СтатусыДокументов.ГотовоКРегистрации;
    Документ.ДатаПодписания = ТекущаяДатаСеанса();
    Если НЕ ЗначениеЗаполнено(Документ.Подписант) Тогда
        Документ.Подписант = Подписант; // Фиксируем того, кто подписал
    КонецЕсли;

    
КонецПроцедуры

// 3. Вернуть на доработку
Процедура ВернутьНаДоработку(Документ) Экспорт
    
    Если Документ.СтатусДокумента <> Перечисления.СтатусыДокументов.НаПодписи Тогда
        ВызватьИсключение "Вернуть на доработку можно только документ с подписи.";
    КонецЕсли;
    
    Документ.СтатусДокумента = Перечисления.СтатусыДокументов.НеПодписан;
    
    // Пересылаем обратно автору
    Если ЗначениеЗаполнено(Документ.Исполнитель) Тогда
        МассивСотрудников = Новый Массив;
        МассивСотрудников.Добавить(Документ.Исполнитель);
        ПересылкаДокументов.ПереслатьДокумент(Документ.Ссылка, МассивСотрудников, Документ.Подписант);
    КонецЕсли;
    
КонецПроцедуры

// 4. Регистрация документа (из "Готово к регистрации")
Процедура ЗарегистрироватьДокумент(Документ, Регистратор) Экспорт
    
    Если Документ.СтатусДокумента <> Перечисления.СтатусыДокументов.ГотовоКРегистрации Тогда
        ВызватьИсключение "Зарегистрировать можно только подписанный документ.";
    КонецЕсли;
    
    Документ.СтатусДокумента = Перечисления.СтатусыДокументов.Зарегистрировано;
    
КонецПроцедуры